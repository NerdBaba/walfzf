cmd_collection() {
    local page=1 download_all=0 username="" collection_id_arg="" pos_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--page) page="$2"; shift 2;;
            -a|--all) download_all=1; shift;;
            --) shift; pos_args+=("$@"); break;;
            *) pos_args+=("$1"); shift;;
        esac
    done
    if [[ ${#pos_args[@]} -eq 0 ]]; then _log_error "Username required."; _usage; return 1; fi
    username="${pos_args[0]}"; [[ ${#pos_args[@]} -gt 1 ]] && collection_id_arg="${pos_args[1]}"; local collection_id="$collection_id_arg"
    if [[ -z "$collection_id" ]]; then
        _log_info "Fetching collections for user: $(_c bold "$username")..."
        local collections_response=$(_api_list_user_collections "$username") || return 1
        if [[ "$(echo "$collections_response" | jq -r '.data | length')" -eq 0 ]]; then _log_error "No collections or user not found."; return 1; fi
        local fzf_collections_input=$(echo "$collections_response" | jq -r '.data[] | "\(.label) (\(.id))"')
        local selected_collection_str=$(_fzf_select "$fzf_collections_input" "false" "false") || { _log_info "No collection selected."; return 1; }
        collection_id=$(_extract_from_parens "$selected_collection_str"); if [[ -z "$collection_id" ]]; then _log_error "Could not extract ID from: $selected_collection_str"; return 1; fi
    fi
    _log_info "Selected collection ID: $(_c bold "$collection_id")"
    if [[ "$download_all" -eq 1 ]]; then
        _log_info "Downloading all from collection $collection_id for $username..."
        local current_page=1
        while true; do
            _log_info "Fetching page $current_page..."
            local images_response=$(_api_get_collection_images "$username" "$collection_id" "$current_page") || break
            local images_in_page=$(echo "$images_response" | jq -r '.data[] | .path')
            if [[ -z "$images_in_page" ]]; then _log_info "No more images."; break; fi
            echo "$images_in_page" | while IFS= read -r image_url; do _dl_save "$image_url"; done
            if [[ "$current_page" -ge "$(echo "$images_response" | jq -r '.meta.last_page')" ]]; then _log_info "Last page reached."; break; fi
            current_page=$((current_page + 1))
        done
        _log_success "Finished downloading all."
    else
        _handle_image_selection_loop "$page" "false" _api_get_collection_images "$username" "$collection_id"
    fi
}

cmd_preview() {
    local text_line="$1"

    _clear_preview_pane_text_content() {
        if command -v tput >/dev/null && [ -t 1 ]; then tput clear;
        elif [ -t 1 ]; then printf "\033c"; fi
    }
    _cursor_home_and_clear_line() {
         printf "\033[H\033[K"
    }

    local success_messages=("Preview loaded!" "Image ready." "Displayed." "Voila!" "Rendered.")
    _print_kitty_success_text_on_first_line() {
        _cursor_home_and_clear_line
        local r_idx=$((RANDOM % ${#success_messages[@]})); echo "${success_messages[$r_idx]}"
    }

    if echo "$text_line" | grep -Eq -- "(Next page -->|Previous page <--)"; then
        _clear_preview_pane_text_content
        echo "Pagination Item - No Preview"
        return 0
    fi

    local image_url
    image_url=$(_extract_from_parens "$text_line")

    if [[ -z "$image_url" ]]; then
        _clear_preview_pane_text_content
        echo "Preview Error: Could not extract URL from: $text_line"
        return 1
    fi

    local full_url="${image_url%%|*}"
    local thumb_url="${image_url#*|}"
    [[ "$full_url" == "$thumb_url" ]] && thumb_url=""

    local preview_url="$full_url"
    if [[ "${THUMB_MODE:-}" == "true" && -n "$thumb_url" ]]; then
        preview_url="$thumb_url"
        _log_debug "Thumb mode: using thumbnail URL: $preview_url"
    fi

    local temp_preview_dir="$CONFIG_TEMP_FOLDER/preview_cache"
    local filename; filename=$(basename "$preview_url"); filename="${filename%%\?*}"
    local temp_image_file="$temp_preview_dir/$filename"

    _clear_preview_pane_text_content
    printf "$(_c dim '[Previewing...]')\n"
    sleep 0.03

    if [[ ! -f "$temp_image_file" ]]; then
        _log_debug "Preview: '$filename' not in cache. Downloading from $preview_url"

        local spinner_chars=("|" "/" "-" "\\")
        local spin_i=0
        printf "\033[H"
        echo -ne "${spinner_chars[$spin_i]} $(_c cyan 'Loading...')"

        curl -sL --compressed --max-time 15 -o "$temp_image_file" "$preview_url" &
        local curl_pid=$!

        while kill -0 $curl_pid 2>/dev/null; do
            spin_i=$(((spin_i + 1) % 4))
            echo -ne "\033[H${spinner_chars[$spin_i]} $(_c cyan 'Loading...')"
            sleep 0.1
        done
        wait $curl_pid
        local curl_exit_code=$?

        printf "\033[H\033[K"

        if [[ "$curl_exit_code" -ne 0 ]]; then
            echo "$(_c yellow "Preview Download Error") (code $curl_exit_code): $preview_url"
            _log_error "Curl failed ($curl_exit_code) for $preview_url"
            rm -f "$temp_image_file"
            return 1
        fi
        _log_debug "Preview: '$filename' downloaded to $temp_image_file"
    else
        printf "\033[H\033[K"
        _log_debug "Preview: Using cached '$filename' from $temp_image_file"
    fi

    # Neighbor prefetch
    local url_list_file="$temp_preview_dir/.current_urls.txt"
    if [[ -f "$url_list_file" ]]; then
        local prefetch_cfg="$temp_preview_dir/.prefetch.cfg"
        > "$prefetch_cfg"
        local prefetch_count=0
        local found_current=0
        while IFS= read -r next_url; do
            if [[ "$found_current" -eq 1 && "$prefetch_count" -lt 2 ]]; then
                local next_fn; next_fn=$(basename "$next_url"); next_fn="${next_fn%%\?*}"
                local next_file="$temp_preview_dir/$next_fn"
                if [[ ! -f "$next_file" ]]; then
                    printf 'url = "%s"\noutput = "%s"\ncompressed\n\n' "$next_url" "$next_file" >> "$prefetch_cfg"
                    prefetch_count=$((prefetch_count + 1))
                fi
            fi
            [[ "$next_url" == "$preview_url" ]] && found_current=1
        done < "$url_list_file"
        if [[ "$prefetch_count" -gt 0 ]]; then
            curl --parallel --parallel-max 2 --silent --connect-timeout 10 --config "$prefetch_cfg" &
            _log_debug "Neighbor prefetch started for $prefetch_count image(s)"
        fi
        rm -f "$prefetch_cfg"
    fi

    # Validate image file
    local file_type
    file_type=$(file -b "$temp_image_file" 2>/dev/null || echo "unknown")
    _log_debug "File details for $temp_image_file: $file_type"

    if ! echo "$file_type" | grep -qi "image"; then
        _log_debug "Invalid image detected. Re-downloading."
        rm -f "$temp_image_file"
        _cursor_home_and_clear_line
        echo "$(_c yellow 'Re-downloading corrupted image...')"
        if ! curl -sL --compressed --max-time 15 -o "$temp_image_file" "$preview_url"; then
            echo "$(_c red 'Preview: Failed to re-download image.')"
            return 1
        fi
    fi

    local fzf_cols="${FZF_PREVIEW_COLUMNS:-80}"; local fzf_lines="${FZF_PREVIEW_LINES:-24}"

    _clear_preview_pane_text_content

    if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitty &>/dev/null; then
        _log_debug "Attempting Kitty preview for $temp_image_file"
        if kitty icat --clear --silent --align=left --transfer-mode=stream --stdin=no --place="${fzf_cols}x${fzf_lines}@0x0" --scale-up "$temp_image_file"; then
            _print_kitty_success_text_on_first_line
            return 0
        fi
        _log_debug "Kitty icat failed. Trying Chafa."
        _clear_preview_pane_text_content
    fi

    if command -v chafa &>/dev/null; then
        _log_debug "Attempting Chafa preview for $temp_image_file"
        if [[ -f "$temp_image_file" ]]; then
            _clear_preview_pane_text_content
            if chafa --clear --animate=false --size="${fzf_cols}x${fzf_lines}" --stretch --symbols=braille --colors=full --dither=ordered "$temp_image_file"; then
                return 0
            fi
            _log_debug "Chafa failed."
            _clear_preview_pane_text_content
        else
             _log_debug "Cached file disappeared before Chafa."
             _clear_preview_pane_text_content
        fi
    fi

    _clear_preview_pane_text_content
    echo "$(_c yellow 'Preview: No suitable previewer or image issue.') URL: $preview_url"
    return 1
}

cmd_setup() {
    local new_folder=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--folder) new_folder="$2"; shift 2 ;;
            *) new_folder="$1"; shift ;;
        esac
    done

    _load_config

    if [[ -z "$new_folder" ]]; then
        echo "Current save folder: $(_c bold "$CONFIG_SAVE_FOLDER")"
        return 0
    fi

    new_folder="${new_folder/#\~/$HOME}"

    if [[ "$new_folder" != /* ]]; then
        _log_error "Folder must be an absolute path (got: $new_folder)"
        return 1
    fi

    mkdir -p "$new_folder" || { _log_error "Failed to create directory: $new_folder"; return 1; }

    if [[ -f "$CONFIG_FILE" ]]; then
        sed -i.bak "s|^CONFIG_SAVE_FOLDER=.*|CONFIG_SAVE_FOLDER=\"$new_folder\"|" "$CONFIG_FILE" && rm -f "${CONFIG_FILE}.bak"
    else
        echo "CONFIG_SAVE_FOLDER=\"$new_folder\"" >> "$CONFIG_FILE"
    fi

    CONFIG_SAVE_FOLDER="$new_folder"
    _log_success "Save folder set to: $(_c bold "$CONFIG_SAVE_FOLDER")"
}

# --- Interactive Setup Wizard ---
cmd_wizard() {
    echo ""
    echo "$(_c bold 'Welcome to walfzf Setup Wizard!')"
    echo "$(_c dim 'Press Ctrl+C to cancel at any time.')"
    echo ""

    _load_config

    # Save folder
    echo "$(_c cyan '1. Wallpaper Save Folder')"
    echo "   Current: $(_c bold "$CONFIG_SAVE_FOLDER")"
    read -rp "   New path (press Enter to keep current): " wizard_folder
    if [[ -n "$wizard_folder" ]]; then
        wizard_folder="${wizard_folder/#\~/$HOME}"
        mkdir -p "$wizard_folder" || { _log_error "Cannot create: $wizard_folder"; return 1; }
        sed -i.bak "s|^CONFIG_SAVE_FOLDER=.*|CONFIG_SAVE_FOLDER=\"$wizard_folder\"|" "$CONFIG_FILE" && rm -f "${CONFIG_FILE}.bak"
        CONFIG_SAVE_FOLDER="$wizard_folder"
        _log_success "Save folder: $CONFIG_SAVE_FOLDER"
    fi
    echo ""

    # Categories
    echo "$(_c cyan '2. Search Categories')"
    echo "   Current: General=$CONFIG_SEARCH_CATEGORIES_GENERAL, Anime=$CONFIG_SEARCH_CATEGORIES_ANIME, People=$CONFIG_SEARCH_CATEGORIES_PEOPLE"
    read -rp "   Include general? (y/n) [y]: " wizard_cat_g
    read -rp "   Include anime? (y/n) [y]: " wizard_cat_a
    read -rp "   Include people? (y/n) [y]: " wizard_cat_p
    if [[ "${wizard_cat_g:-y}" =~ ^[Yy]$ ]]; then
        sed -i.bak 's|^CONFIG_SEARCH_CATEGORIES_GENERAL=.*|CONFIG_SEARCH_CATEGORIES_GENERAL="true"|' "$CONFIG_FILE"
    else
        sed -i.bak 's|^CONFIG_SEARCH_CATEGORIES_GENERAL=.*|CONFIG_SEARCH_CATEGORIES_GENERAL="false"|' "$CONFIG_FILE"
    fi
    if [[ "${wizard_cat_a:-y}" =~ ^[Yy]$ ]]; then
        sed -i.bak 's|^CONFIG_SEARCH_CATEGORIES_ANIME=.*|CONFIG_SEARCH_CATEGORIES_ANIME="true"|' "$CONFIG_FILE"
    else
        sed -i.bak 's|^CONFIG_SEARCH_CATEGORIES_ANIME=.*|CONFIG_SEARCH_CATEGORIES_ANIME="false"|' "$CONFIG_FILE"
    fi
    if [[ "${wizard_cat_p:-y}" =~ ^[Yy]$ ]]; then
        sed -i.bak 's|^CONFIG_SEARCH_CATEGORIES_PEOPLE=.*|CONFIG_SEARCH_CATEGORIES_PEOPLE="true"|' "$CONFIG_FILE"
    else
        sed -i.bak 's|^CONFIG_SEARCH_CATEGORIES_PEOPLE=.*|CONFIG_SEARCH_CATEGORIES_PEOPLE="false"|' "$CONFIG_FILE"
    fi
    rm -f "${CONFIG_FILE}.bak"
    echo ""

    # Purity
    echo "$(_c cyan '3. Content Purity Filters')"
    echo "   Current: SFW=$CONFIG_SEARCH_PURITY_SFW, Sketchy=$CONFIG_SEARCH_PURITY_SKETCHY, NSFW=$CONFIG_SEARCH_PURITY_NSFW"
    read -rp "   Include SFW? (y/n) [y]: " wizard_pur_s
    read -rp "   Include Sketchy? (y/n) [y]: " wizard_pur_k
    read -rp "   Include NSFW? (y/n) [n]: " wizard_pur_n
    if [[ "${wizard_pur_s:-y}" =~ ^[Yy]$ ]]; then
        sed -i.bak 's|^CONFIG_SEARCH_PURITY_SFW=.*|CONFIG_SEARCH_PURITY_SFW="true"|' "$CONFIG_FILE"
    else
        sed -i.bak 's|^CONFIG_SEARCH_PURITY_SFW=.*|CONFIG_SEARCH_PURITY_SFW="false"|' "$CONFIG_FILE"
    fi
    if [[ "${wizard_pur_k:-y}" =~ ^[Yy]$ ]]; then
        sed -i.bak 's|^CONFIG_SEARCH_PURITY_SKETCHY=.*|CONFIG_SEARCH_PURITY_SKETCHY="true"|' "$CONFIG_FILE"
    else
        sed -i.bak 's|^CONFIG_SEARCH_PURITY_SKETCHY=.*|CONFIG_SEARCH_PURITY_SKETCHY="false"|' "$CONFIG_FILE"
    fi
    if [[ "${wizard_pur_n:-n}" =~ ^[Yy]$ ]]; then
        sed -i.bak 's|^CONFIG_SEARCH_PURITY_NSFW=.*|CONFIG_SEARCH_PURITY_NSFW="true"|' "$CONFIG_FILE"
    else
        sed -i.bak 's|^CONFIG_SEARCH_PURITY_NSFW=.*|CONFIG_SEARCH_PURITY_NSFW="false"|' "$CONFIG_FILE"
    fi
    rm -f "${CONFIG_FILE}.bak"
    echo ""

    echo "$(_c green 'Setup complete!')"
    echo "$(_c dim 'You can always re-run this with: walfzf wizard')"
    echo "$(_c dim 'Or edit the config directly with: walfzf edit')"
    echo ""
}

_usage() {
    local script_name; if [[ -n "${BASH_SOURCE[0]}" && -f "${BASH_SOURCE[0]}" ]]; then script_name=$(basename "${BASH_SOURCE[0]}"); else script_name="walfzf"; fi
    cat <<EOF
$(_c bold "$script_name") - Search, preview, and download wallpapers from $(_c cyan 'wallhaven.cc')

$(_c bold 'Usage:')
  $script_name [command] [options] [arguments]

$(_c bold 'Search Commands:')
  $(_c cyan 'search (s)')  <query> [options]    Search wallpapers
    $(_c dim '-p, --page <n>')       Start from page N
    $(_c dim '-b, --background-preload')  Preload all images for faster previews
    $(_c dim '-t, --thumbs')         Use low-res thumbnails for faster loading

  $(_c cyan 'latest (l)') [options]              Browse newest wallpapers
    $(_c dim 'Same options as search')

  $(_c cyan 'toplist (t)') [options]             Browse top-rated wallpapers
    $(_c dim '-r, --range <range>')  Time range: 1d, 3d, 1w, 1M, 3M, 6M, 1y
    $(_c dim 'Same options as search')

  $(_c cyan 'random (r)') [options]              Browse random wallpapers
    $(_c dim '-s, --seed <seed>')    Seed for reproducible results
    $(_c dim 'Same options as search')

  $(_c cyan 'tags') [filter|sort]                Browse popular tags
    $(_c dim 'Sort: popular (default), viewed, tagged, subs')
    $(_c dim 'Filter: pass any text to filter tags')

$(_c bold 'Browse & Download:')
  $(_c cyan 'download (d)') <id...>              Download wallpapers by Wallhaven ID
  $(_c cyan 'collection (c)') <user> [coll_id]   Browse user collections
    $(_c dim '-p, --page <n>')       Start from page N
    $(_c dim '-a, --all')            Download all images from collection

$(_c bold 'Favorites & History:')
  $(_c cyan 'info') <id>                          Show detailed wallpaper info
  $(_c cyan 'fav') [add|rm|list|dl] [id]         Manage favorite wallpapers
    $(_c dim 'fav add <id>')         Add wallpaper to favorites
    $(_c dim 'fav rm <id>')          Remove from favorites
    $(_c dim 'fav list')             List all favorites
    $(_c dim 'fav dl')              Download all favorites

  $(_c cyan 'history') [limit]                     Show recent activity (default: 20)
  $(_c cyan 'history-clear')                       Clear all history

$(_c bold 'Wallpaper:')
  $(_c cyan 'setwall') <id>                       Set wallpaper as desktop (macOS only)

$(_c bold 'Configuration:')
  $(_c cyan 'edit (e)')                           Open config file in editor
  $(_c cyan 'setup') [folder]                     View or change save folder
  $(_c cyan 'wizard')                             Interactive setup wizard

$(_c bold 'Help:')
  $(_c cyan 'help (h)')                           Show this help message

$(_c dim 'Config: $CONFIG_FILE')
$(_c dim 'Debug: WALLHAVEN_CLI_DEBUG=1 $script_name search nature')
EOF
}

main() {
    if [[ "${1:-}" == "--is-preview" && "${2:-}" == "--actual-config-path" ]]; then
        local cfg_path_preview="$3"; cfg_path_preview="${cfg_path_preview#\'}"; cfg_path_preview="${cfg_path_preview%\'}"
        local preview_thumb_mode="false"
        shift 3
        if [[ "${1:-}" == "--thumb-mode" ]]; then preview_thumb_mode="true"; shift; fi
        if [[ -f "$cfg_path_preview" ]]; then
            # shellcheck source=/dev/null
            source "$cfg_path_preview";
        else
            echo "walfzf: Preview Warning: Config '$cfg_path_preview' not found. Using defaults." >&2
            CONFIG_TEMP_FOLDER="${DEFAULT_TEMP_FOLDER}"
        fi
        mkdir -p "$CONFIG_TEMP_FOLDER/preview_cache"

        if [[ "${1:-}" == "preview" ]]; then THUMB_MODE="$preview_thumb_mode" cmd_preview "${@:2}"; exit $?;
        else echo "walfzf: Error: Preview invocation structure incorrect." >&2; exit 1; fi
    fi

    _ensure_deps; _load_config; _ensure_dirs

    THUMB_MODE="false"
    local COMMAND="${1:-help}"
    [[ $# -gt 0 ]] && shift || true

    case "$COMMAND" in
        search|s) cmd_search "$@" ;;
        latest|l) cmd_latest "$@" ;;
        toplist|t) cmd_toplist "$@" ;;
        random|r) cmd_random "$@" ;;
        tags) cmd_tags "$@" ;;
        download|d) cmd_download "$@" ;;
        edit|e) cmd_edit "$@" ;;
        collection|c) cmd_collection "$@" ;;
        setup) cmd_setup "$@" ;;
        wizard) cmd_wizard "$@" ;;
        info)
            if [[ $# -eq 0 ]]; then _log_error "Wallpaper ID required."; _usage; exit 1; fi
            _show_wallpaper_info "$1"
            ;;
        fav|favorites)
            local fav_action="${1:-list}"
            case "$fav_action" in
                add) [[ $# -lt 2 ]] && { _log_error "ID required."; exit 1; }; _fav_add "$2" ;;
                rm|remove) [[ $# -lt 2 ]] && { _log_error "ID required."; exit 1; }; _fav_remove "$2" ;;
                list) _fav_list ;;
                dl|download) _fav_download_all ;;
                *) _log_error "Unknown fav action: $fav_action. Use: add, rm, list, dl"; exit 1 ;;
            esac
            ;;
        history)
            _history_show "${1:-20}"
            ;;
        history-clear)
            _history_clear
            ;;
        setwall|set-wallpaper)
            if [[ $# -eq 0 ]]; then _log_error "Wallpaper ID required."; _usage; exit 1; fi
            _set_wallpaper "$1"
            ;;
        help|h|--help|-h) _usage ;;
        *) _log_error "Unknown command: $COMMAND"; _usage; exit 1 ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
