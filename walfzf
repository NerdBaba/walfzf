# --- History Management ---
_HISTORY_FILE=""
_init_history() {
    _HISTORY_FILE="$CONFIG_DIR/history.jsonl"
    if [[ ! -f "$_HISTORY_FILE" ]]; then
        : > "$_HISTORY_FILE"  # Create empty file
    fi
}

_history_add() {
    local id="$1" action="$2" detail="${3:-}"
    _init_history
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date +"%Y-%m-%dT%H:%M:%SZ")
    # Use jq to safely escape JSON values
    jq -nc --arg id "$id" --arg action "$action" --arg detail "$detail" --arg ts "$timestamp" \
        '{id:$id, action:$action, detail:$detail, timestamp:$ts}' >> "$_HISTORY_FILE"
}

_history_show() {
    local limit="${1:-20}"
    _init_history
    if [[ ! -f "$_HISTORY_FILE" ]]; then
        _log_info "No history yet."
        return 0
    fi
    # Show last N entries (use tail -r on macOS, tac on Linux)
    local entries
    if command -v tac >/dev/null 2>&1; then
        entries=$(tac "$_HISTORY_FILE" | head -n "$limit" | jq -r '"\(.timestamp) | \(.action) | \(.id) | \(.detail)"' 2>/dev/null)
    elif command -v tail >/dev/null 2>&1; then
        entries=$(tail -r "$_HISTORY_FILE" 2>/dev/null | head -n "$limit" | jq -r '"\(.timestamp) | \(.action) | \(.id) | \(.detail)"' 2>/dev/null)
    else
        entries=$(jq -r '"\(.timestamp) | \(.action) | \(.id) | \(.detail)"' "$_HISTORY_FILE" 2>/dev/null | tail -n "$limit")
    fi
    if [[ -z "$entries" ]]; then
        _log_info "History is empty."
        return 0
    fi
    echo "$(_c bold 'Recent Activity'):"
    echo "$entries" | while IFS='|' read -r ts action id detail; do
        echo "  $(_c dim "$ts") $(_c cyan "$action") $(_c bold "$id") $(_c dim "$detail")"
    done
}

_history_clear() {
    _init_history
    : > "$_HISTORY_FILE"
    _log_success "History cleared."
}

# --- Favorites Management ---
_FAVORITES_FILE=""
_init_favorites() {
    _FAVORITES_FILE="$CONFIG_DIR/favorites.json"
    if [[ ! -f "$_FAVORITES_FILE" ]]; then
        echo "[]" > "$_FAVORITES_FILE"
    fi
}

_fav_add() {
    local id="$1"
    _init_favorites
    local exists
    exists=$(jq --arg id "$id" '[.[] | select(.id == $id)] | length' "$_FAVORITES_FILE" 2>/dev/null)
    if [[ "$exists" -gt 0 ]]; then
        _log_warn "$(_c bold "$id") is already in favorites."
        return 0
    fi
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date +"%Y-%m-%dT%H:%M:%SZ")
    # Read current, append, write back
    local tmp
    tmp=$(mktemp)
    jq --arg id "$id" --arg ts "$timestamp" '. + [{"id": $id, "added_at": $ts}]' "$_FAVORITES_FILE" > "$tmp" && mv "$tmp" "$_FAVORITES_FILE"
    _log_success "Added $(_c bold "$id") to favorites."
    _history_add "$id" "favorite" "added to favorites"
}

_fav_remove() {
    local id="$1"
    _init_favorites
    local exists
    exists=$(jq --arg id "$id" '[.[] | select(.id == $id)] | length' "$_FAVORITES_FILE" 2>/dev/null)
    if [[ "$exists" -eq 0 ]]; then
        _log_warn "$(_c bold "$id") is not in favorites."
        return 0
    fi
    local tmp
    tmp=$(mktemp)
    jq --arg id "$id" '[.[] | select(.id != $id)]' "$_FAVORITES_FILE" > "$tmp" && mv "$tmp" "$_FAVORITES_FILE"
    _log_success "Removed $(_c bold "$id") from favorites."
}

_fav_list() {
    _init_favorites
    local count
    count=$(jq 'length' "$_FAVORITES_FILE" 2>/dev/null)
    if [[ "$count" -eq 0 ]]; then
        _log_info "No favorites saved yet. Press $(_c bold 'F') while browsing to add favorites."
        return 0
    fi
    echo "$(_c bold 'Your Favorites') ($count wallpapers):"
    jq -r '.[] | "  \(.id)  (added: \(.added_at))"' "$_FAVORITES_FILE" 2>/dev/null
}

_fav_download_all() {
    _init_favorites
    local ids
    ids=$(jq -r '.[].id' "$_FAVORITES_FILE" 2>/dev/null)
    if [[ -z "$ids" ]]; then
        _log_info "No favorites to download."
        return 0
    fi
    local total
    total=$(echo "$ids" | wc -l | tr -d ' ')
    _log_info "Downloading $(_c bold "$total") favorite(s)..."
    local i=0
    echo "$ids" | while IFS= read -r wid; do
        i=$((i + 1))
        _log_info "[$i/$total] Fetching details for $wid..."
        local image_details
        image_details=$(_api_get_image_details "$wid") || continue
        local image_url
        image_url=$(echo "$image_details" | jq -r '.data.path')
        if [[ -n "$image_url" && "$image_url" != "null" ]]; then
            _dl_save "$image_url"
        else
            _log_error "Could not find URL for ID: $wid"
        fi
    done
    _log_success "All favorites downloaded."
}

# --- Wallhaven Info Panel ---
_show_wallpaper_info() {
    local image_id="$1"
    _log_info "Fetching details for $(_c bold "$image_id")..."
    local response
    response=$(_api_get_image_details "$image_id") || return 1

    local data
    data=$(echo "$response" | jq -r '.data')

    local id resolution views favorites likes purity category created_at uploader tags
    id=$(echo "$data" | jq -r '.id')
    resolution=$(echo "$data" | jq -r '.resolution // "unknown"')
    views=$(echo "$data" | jq -r '.views // 0')
    favorites=$(echo "$data" | jq -r '.favorites // 0')
    likes=$(echo "$data" | jq -r '.likes // 0')
    purity=$(echo "$data" | jq -r '.purity // "unknown"')
    category=$(echo "$data" | jq -r '.category // "unknown"')
    created_at=$(echo "$data" | jq -r '.created_at // "unknown"')
    uploader=$(echo "$data" | jq -r '.uploader.name // "anonymous"')
    local file_size
    file_size=$(echo "$data" | jq -r '.file_size // 0')
    local file_size_human
    if [[ "$file_size" != "null" && "$file_size" -gt 0 ]] 2>/dev/null; then
        if [[ "$file_size" -gt 1048576 ]]; then
            file_size_human="$(( file_size / 1048576 )) MB"
        else
            file_size_human="$(( file_size / 1024 )) KB"
        fi
    else
        file_size_human="unknown"
    fi

    # Tags
    local tags_str
    tags_str=$(echo "$data" | jq -r '.tags // [] | map(.name) | join(", ")' 2>/dev/null)
    [[ "$tags_str" == "null" || -z "$tags_str" ]] && tags_str="none"

    echo ""
    echo "$(_c bold 'Wallpaper Info'):"
    echo "  $(_c cyan 'ID:')         $id"
    echo "  $(_c cyan 'Resolution:') $resolution"
    echo "  $(_c cyan 'File Size:')  $file_size_human"
    echo "  $(_c cyan 'Category:')   $category"
    echo "  $(_c cyan 'Purity:')     $purity"
    echo "  $(_c cyan 'Uploader:')   $uploader"
    echo "  $(_c cyan 'Created:')    $created_at"
    echo "  $(_c cyan 'Views:')      $views"
    echo "  $(_c cyan 'Likes:')      $likes"
    echo "  $(_c cyan 'Favorites:')  $favorites"
    echo "  $(_c cyan 'Tags:')       $tags_str"
    echo ""
}

# --- Set as Wallpaper (macOS) ---
_set_wallpaper() {
    local image_id="$1"
    _log_info "Fetching wallpaper for $(_c bold "$image_id")..."
    local response
    response=$(_api_get_image_details "$image_id") || return 1
    local image_url
    image_url=$(echo "$response" | jq -r '.data.path')
    if [[ -z "$image_url" || "$image_url" == "null" ]]; then
        _log_error "Could not find URL for ID: $image_id"
        return 1
    fi

    # Download to temp
    local temp_file="${CONFIG_TEMP_FOLDER}/wallpaper_${image_id}"
    _log_info "Downloading wallpaper..."
    if ! curl -sL --compressed -o "$temp_file" "$image_url"; then
        _log_error "Failed to download wallpaper."
        return 1
    fi

    # Set as desktop wallpaper (macOS)
    if [[ "$(uname)" == "Darwin" ]]; then
        _log_info "Setting as desktop wallpaper..."
        # Escape quotes and backslashes in path for AppleScript
        local escaped_path="${temp_file//\\/\\\\}"
        escaped_path="${escaped_path//\"/\\\"}"
        if osascript -e "tell application \"Finder\" to set desktop picture to POSIX file \"$escaped_path\""; then
            _log_success "Desktop wallpaper set to $(_c bold "$image_id")!"
        else
            _log_error "Failed to set desktop wallpaper via osascript."
            return 1
        fi
    else
        _log_error "Set wallpaper is only supported on macOS."
        _log_info "Wallpaper downloaded to: $temp_file"
        return 1
    fi
}

_urlencode() {
    jq -nr --arg str "$1" '$str|@uri'
}

_make_request() {
    local url="$1"
    _log_debug "Making API request to: $url"

    # Add API key if configured
    local headers=()
    if [[ -n "${CONFIG_API_KEY:-}" ]]; then
        headers+=("-H" "X-API-Key: $CONFIG_API_KEY")
    fi

    if ! response=$(curl -sL "${headers[@]}" "$url"); then
        _log_error "Failed to make request to $url"
        return 1
    fi
    if echo "$response" | jq -e '.error' > /dev/null; then
        error_message=$(echo "$response" | jq -r '.error')
        _log_error "API Error for $url: $error_message"
        return 1
    fi
    _log_debug "API response received."
    echo "$response"
}

_dl_save() {
    local url="$1"
    local folder="${2:-$CONFIG_SAVE_FOLDER}"
    local name
    name=$(basename "$url")
    name="${name%%\?*}"
    local file_path="${folder}/${name}"

    mkdir -p "$folder"
    _log_info "Downloading $(_c bold "$name")..."
    if curl -sL --compressed --show-error -o "$file_path" "$url" 2>/dev/null; then
        _log_success "$(_c bold "$name") saved to $(_c dim "$file_path")"
        return 0
    else
        _log_error "Failed to download $url"
        rm -f "$file_path"
        return 1
    fi
}

_extract_from_parens() {
    echo "$1" | sed -n 's/.*(\([^)]*\)).*/\1/p'
}

_fzf_select() {
    local input="$1"
    local enable_preview="$2"
    local allow_multi_select="${3:-false}"
    local fzf_opts=("--border" "--reverse" "--preview-window=right:70%:wrap:border-sharp")

    if [[ "$allow_multi_select" == "true" ]]; then
        fzf_opts+=("-m" "--bind=enter:accept")
        fzf_opts+=("--header=$(_c bold 'TAB/Shift-TAB') to select/deselect, $(_c bold 'Enter') to confirm.")
    else
        fzf_opts+=("--bind=enter:accept")
    fi

    if [[ "$enable_preview" == "true" ]]; then
        local script_abs_path
        if command -v readlink &>/dev/null && readlink -f "${BASH_SOURCE[0]}" &>/dev/null; then
            script_abs_path=$(readlink -f "${BASH_SOURCE[0]}")
        else
            script_abs_path="${BASH_SOURCE[0]}"
        fi
        local preview_cmd="$script_abs_path --is-preview --actual-config-path '$CONFIG_FILE'"
        [[ "${THUMB_MODE:-}" == "true" ]] && preview_cmd="$preview_cmd --thumb-mode"
        fzf_opts+=("--preview=$preview_cmd preview {}")
    fi

    # Colorful prompt - use literal ANSI codes to avoid nested quoting issues
    local colored_prompt
    colored_prompt=$'\033[1m\033[36mwallhaven\033[0m> '
    fzf_opts+=("--prompt=$colored_prompt")

    _log_debug "Starting fzf with options: ${fzf_opts[*]}"
    selection=$(echo -e "$input" | fzf "${fzf_opts[@]}")
    if [[ -z "$selection" ]]; then
        _log_debug "fzf selection cancelled or empty."
        return 1
    fi
    _log_debug "fzf selection made."
    echo "$selection"
    return 0
}

_api_search_images() {
    local query="$1"; local page="$2"; local params="q=$(_urlencode "$query")&page=$page"
    local c_g=0 c_a=0 c_p=0
    [[ "$CONFIG_SEARCH_CATEGORIES_GENERAL" == "true" ]] && c_g=1; [[ "$CONFIG_SEARCH_CATEGORIES_ANIME" == "true" ]] && c_a=1; [[ "$CONFIG_SEARCH_CATEGORIES_PEOPLE" == "true" ]] && c_p=1
    local pur_s=0 pur_k=0 pur_n=0
    [[ "$CONFIG_SEARCH_PURITY_SFW" == "true" ]] && pur_s=1; [[ "$CONFIG_SEARCH_PURITY_SKETCHY" == "true" ]] && pur_k=1; [[ "$CONFIG_SEARCH_PURITY_NSFW" == "true" ]] && pur_n=1
    params="$params&categories=${c_g}${c_a}${c_p}&purity=${pur_s}${pur_k}${pur_n}&order=$(_urlencode "$CONFIG_SEARCH_ORDER")&topRange=$(_urlencode "$CONFIG_SEARCH_TOPRANGE")"
    [[ -n "$CONFIG_SEARCH_ATLEAST" ]] && params="$params&atleast=$(_urlencode "$CONFIG_SEARCH_ATLEAST")"
    [[ -n "$CONFIG_SEARCH_RESOLUTIONS" ]] && params="$params&resolutions=$(_urlencode "$CONFIG_SEARCH_RESOLUTIONS")"
    [[ -n "$CONFIG_SEARCH_RATIOS" ]] && params="$params&ratios=$(_urlencode "$CONFIG_SEARCH_RATIOS")"
    _make_request "$API_BASE_URL/search?$params"
}
