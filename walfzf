cmd_tags() {
    local tag_filter="${1:-}"
    local sort_by="popular"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            popular|viewed|tagged|subs) sort_by="$1"; shift ;;
            -*) _log_error "Unknown option for tags: $1"; _usage; return 1 ;;
            *) tag_filter="$1"; shift ;;
        esac
    done

    local tags_page_html
    tags_page_html=$(curl -sL --compressed "https://wallhaven.cc/tags/$sort_by" 2>/dev/null) || { _log_error "Failed to fetch tags page."; return 1; }

    local tags_list
    tags_list=$(echo "$tags_page_html" | grep -o 'href="https://wallhaven.cc/tag/[0-9]*"[^>]*title="[^"]*"' | sed 's/.*title="\([^"]*\)".*/\1/')

    if [[ -z "$tags_list" ]]; then
        _log_error "Could not parse tags from page."
        return 1
    fi

    if [[ -n "$tag_filter" ]]; then
        tags_list=$(echo "$tags_list" | grep -Fi -- "$tag_filter")
        if [[ -z "$tags_list" ]]; then
            _log_error "No tags matching: $tag_filter"
            return 1
        fi
    fi

    local selected_tag
    local tags_prompt
    tags_prompt=$'\033[1m\033[36mtags\033[0m> '
    selected_tag=$(echo "$tags_list" | fzf --border --reverse --prompt="$tags_prompt" --preview="echo 'Search with: walfzf search {}'") || { _log_info "Tag selection cancelled."; return 1; }

    if [[ -n "$selected_tag" ]]; then
        _log_info "Searching for tag: $(_c bold "$selected_tag")"
        cmd_search "$selected_tag"
    fi
}

