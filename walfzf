        cat > "$CONFIG_FILE" <<'CONFEOF'
# walfzf Configuration File
CONFEOF
        echo "CONFIG_EDITOR=\"$DEFAULT_EDITOR\"" >> "$CONFIG_FILE"
        echo "CONFIG_SAVE_FOLDER=\"$DEFAULT_SAVE_FOLDER\"" >> "$CONFIG_FILE"
