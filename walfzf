#!/usr/bin/env bash
set -euo pipefail

# --- Configuration ---
APP_NAME="walfzf"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$APP_NAME"
CONFIG_FILE="$CONFIG_DIR/config.sh"
API_BASE_URL="https://wallhaven.cc/api/v1"

# Default Configuration Values
DEFAULT_EDITOR="nano"
DEFAULT_SAVE_FOLDER="$HOME/Pictures/wallpapers"
DEFAULT_TEMP_FOLDER="/tmp/$APP_NAME"

# Search Defaults
DEFAULT_SEARCH_CATEGORIES_GENERAL="true"
DEFAULT_SEARCH_CATEGORIES_ANIME="true"
DEFAULT_SEARCH_CATEGORIES_PEOPLE="true"
DEFAULT_SEARCH_ORDER="desc"
DEFAULT_SEARCH_TOPRANGE="1M"
DEFAULT_SEARCH_ATLEAST=""
DEFAULT_SEARCH_RESOLUTIONS=""
DEFAULT_SEARCH_RATIOS=""
DEFAULT_SEARCH_BACKGROUND_PRELOAD="false"
DEFAULT_SEARCH_PURITY_SFW="true"
DEFAULT_SEARCH_PURITY_SKETCHY="true"
DEFAULT_SEARCH_PURITY_NSFW="false"

# --- Color Support ---
_COLOR_ENABLED="false"
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ $(tput colors 2>/dev/null) -ge 8 ]]; then
    _COLOR_ENABLED="true"
fi

_c() {
    if [[ "$_COLOR_ENABLED" == "true" ]]; then
        case "$1" in
            red)     printf "\033[31m%s\033[0m" "$2" ;;
            green)   printf "\033[32m%s\033[0m" "$2" ;;
            yellow)  printf "\033[33m%s\033[0m" "$2" ;;
            blue)    printf "\033[34m%s\033[0m" "$2" ;;
            magenta) printf "\033[35m%s\033[0m" "$2" ;;
            cyan)    printf "\033[36m%s\033[0m" "$2" ;;
            bold)    printf "\033[1m%s\033[0m" "$2" ;;
            dim)     printf "\033[2m%s\033[0m" "$2" ;;
            *)       printf "%s" "$2" ;;
        esac
    else
        printf "%s" "$2"
    fi
}

# --- Utility Functions ---

_log_error() {
    echo "$(_c red "walfzf: Error:") $1" >&2
}
_log_info() {
    echo "$(_c cyan "walfzf:") $1" >&2
}
_log_success() {
    echo "$(_c green "walfzf:") $1" >&2
}
_log_warn() {
    echo "$(_c yellow "walfzf: Warning:") $1" >&2
}
_log_debug() {
    if [[ -n "${WALLHAVEN_CLI_DEBUG:-}" ]]; then
        echo "$(_c dim "walfzf: DEBUG:") $1" >&2
    fi
}

_ensure_deps() {
    local missing=0
    for dep in curl jq fzf file; do
        command -v "$dep" >/dev/null 2>&1 || { _log_error "$dep is not installed. Please install it."; missing=1; }
    done
    if command -v readlink >/dev/null 2>&1 && ! readlink -f . >/dev/null 2>&1; then
        _log_warn "readlink does not support -f. This might cause issues with preview paths if script is called via symlink."
    elif ! command -v readlink >/dev/null 2>&1; then
         _log_warn "readlink command not found. This might cause issues with preview paths if script is called via symlink."
    fi
    if [[ "$missing" -eq 1 ]]; then
        exit 1
    fi
}

_ensure_dirs() {
    mkdir -p "$CONFIG_DIR" \
        "${CONFIG_SAVE_FOLDER}" \
        "${CONFIG_TEMP_FOLDER}"
    mkdir -p "${CONFIG_TEMP_FOLDER}/preview_cache"
}

